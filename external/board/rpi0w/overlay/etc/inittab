# otopi inittab. /init (from Buildroot's cpio) has mounted devtmpfs already.
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -t devpts devpts /dev/pts
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/sbin/ip link set lo up
# Boot partition (settings, SSH keys) before otopi starts
::sysinit:/usr/sbin/otopi-mount-boot
# USB Ethernet gadget (RNDIS for Windows, ECM for macOS and Linux)
::sysinit:/usr/sbin/otopi-usb-gadget

# The viewer. Restarted by init if it exits or panics.
::respawn:/usr/bin/otopi

# Debug access: USB Ethernet gadget with DHCP (Pi is 10.55.0.1), SSH (key only)
::respawn:/usr/sbin/otopi-usbnet usb0
::respawn:/usr/sbin/otopi-usbnet usb1
::respawn:/usr/sbin/otopi-sshd

# Debug shell on the serial console (GPIO 14/15, 115200 baud)
ttyAMA0::respawn:/sbin/getty -L ttyAMA0 115200 vt100

::shutdown:/bin/umount -a -r
