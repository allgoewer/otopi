#!/bin/sh
# Starts dropbear. otopi-read-settings has copied the host keys and
# authorized_keys from ssh/ on the SD card's settings partition, because the
# root filesystem is RAM only. Without an SD card (rpiboot) there is no authorized_keys, so no
# login is possible.

[ -s /root/.ssh/authorized_keys ] || echo "otopi-sshd: no ssh/authorized_keys on the settings partition, SSH login impossible" >&2

# -s: key login only. -R: create missing host keys (no SD card).
exec dropbear -F -E -s -R
