#!/bin/sh
# One interface of the USB Ethernet gadget (otopi-usb-gadget): static address
# and a DHCP server for the computer. Run by init with respawn, once for usb0
# (RNDIS, Windows) and once for usb1 (ECM, macOS and Linux); exits (and is
# restarted) while the interface is missing. Both interfaces have the same
# address. Only the one of the configuration the computer chose has a link;
# the route of the other one is ignored while its link is down.
IF="$1"
if ! ip link show "$IF" >/dev/null 2>&1; then
	sleep 5
	exit 1
fi
echo 1 >/proc/sys/net/ipv4/conf/all/ignore_routes_with_linkdown
ip addr add 10.55.0.1/24 dev "$IF" 2>/dev/null
ip link set "$IF" up
CONF="/var/run/udhcpd.$IF.conf"
{
	echo "interface $IF"
	echo "lease_file /var/run/udhcpd.$IF.leases"
	echo "pidfile /var/run/udhcpd.$IF.pid"
	cat /etc/udhcpd.conf
} >"$CONF"
exec udhcpd -f "$CONF"
