#!/bin/sh
# Mounts the SD card's boot partition read-only on /boot (settings, SSH keys).
# Runs from inittab before otopi starts. Without an SD card (rpiboot) it gives
# up after 3 s; otopi then uses its defaults.

BOOT_DEV=/dev/mmcblk0p1

mkdir -p /boot
grep -q " /boot " /proc/mounts && exit 0

# The SD card can appear shortly after init starts.
i=0
while [ ! -b "$BOOT_DEV" ] && [ $i -lt 30 ]; do
	sleep 0.1
	i=$((i + 1))
done
if [ -b "$BOOT_DEV" ]; then
	mount -t vfat -o ro "$BOOT_DEV" /boot
else
	echo "otopi-mount-boot: no SD card, /boot not mounted" >&2
fi
exit 0
