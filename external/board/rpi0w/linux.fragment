# otopi: no modules; everything the viewer needs is builtin.
# gen-linux-defconfig.sh applies this on top of bcmrpi_defconfig with all
# "=m" options removed, and writes linux.defconfig. Buildroot also applies it
# on top of linux.defconfig, so small changes work without regenerating.
# CONFIG_MODULES is not set

# Boot: initramfs (LZ4) embedded by Buildroot, quiet and fast
CONFIG_BLK_DEV_INITRD=y
# Single LZ4 decompression: the kernel image is LZ4 (BR2_LINUX_KERNEL_LZ4),
# the embedded cpio is not compressed separately. INITRAMFS_SOURCE is set here
# only so that the compression choice is visible while the fragment is merged;
# Buildroot sets the same value afterwards.
CONFIG_INITRAMFS_SOURCE="${BR_BINARIES_DIR}/rootfs.cpio"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_RD_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PRINTK_TIME=y
# CONFIG_LOGO is not set

# Display: vc4 KMS on HDMI, no fbdev. vc4 depends on SND && SND_SOC (HDMI
# audio), so the sound core stays on with no other sound drivers.
CONFIG_DRM=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_DRM_VC4=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_RASPBERRYPI_FIRMWARE=y
# vc4 HDMI reads the EDID over i2c2 (DDC); without it vc4 defers forever.
CONFIG_I2C_BCM2835=y
# CONFIG_DRM_VC4_HDMI_CEC is not set
# CONFIG_DRM_V3D is not set
# CONFIG_DRM_UDL is not set
# CONFIG_DRM_PANEL_SIMPLE is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FB_TFT is not set

# WiFi: BCM43430 over SDIO, cfg80211 only
CONFIG_CFG80211=y
# CONFIG_CFG80211_WEXT is not set
# CONFIG_MAC80211 is not set
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
# CONFIG_BRCMFMAC_USB is not set
CONFIG_FW_LOADER=y
# CONFIG_RFKILL is not set

# USB: device mode only (OTG port), Ethernet gadget (RNDIS + ECM) for
# debugging and the boot partition as a drive, set up in configfs by
# otopi-usb-gadget. The legacy g_ether has no
# Microsoft OS descriptors, so Windows does not load its RNDIS driver for it.
CONFIG_USB_SUPPORT=y
# CONFIG_USB is not set
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
# CONFIG_USB_ETH is not set
# CONFIG_USB_CONFIGFS_SERIAL is not set
# CONFIG_USB_CONFIGFS_ACM is not set
# CONFIG_USB_CONFIGFS_OBEX is not set
# CONFIG_USB_CONFIGFS_NCM is not set
# CONFIG_USB_CONFIGFS_ECM_SUBSET is not set
# CONFIG_USB_CONFIGFS_EEM is not set
# CONFIG_USB_CONFIGFS_F_LB_SS is not set
# CONFIG_USB_CONFIGFS_F_FS is not set
# CONFIG_USB_CONFIGFS_F_UAC1 is not set
# CONFIG_USB_CONFIGFS_F_UAC2 is not set
# CONFIG_USB_CONFIGFS_F_MIDI is not set
# CONFIG_USB_CONFIGFS_F_HID is not set
# CONFIG_USB_CONFIGFS_F_PRINTER is not set

# Settings partition (FAT) on the SD card: settings and SSH keys
CONFIG_MMC=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Not needed
# CONFIG_BT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
